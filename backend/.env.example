# Copia este archivo a .env y completa los valores.

PORT=4000
# En desarrollo se acepta cualquier puerto de localhost (Vite a veces cambia
# de 5173 a 5174 si el puerto esta ocupado). En produccion manda esta lista.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_CLAVE_DE_MYSQL
DB_NAME=bgoat

# --- Seguridad -------------------------------------------------------
# Cambia JWT_SECRET por una cadena larga y aleatoria.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --- Correo (recuperar contrasena) -------------------------------------
# Sin SMTP_USER/SMTP_PASS el backend no envia correos: escribe el enlace de
# recuperacion en la consola (sirve para desarrollo).
# Con Gmail: SMTP_PASS es una "contrasena de aplicacion" de 16 letras
# (Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de
# aplicaciones), NO la contrasena normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente que ve el usuario. Por defecto: "BGoat <SMTP_USER>".
SMTP_FROM=
# Direccion del web: el enlace del correo abre <APP_URL>/?restablecer=...
APP_URL=http://localhost:5173
