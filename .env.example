# Copia este archivo a .env EN EL SERVIDOR y completa los valores.
# El .env real nunca se versiona (esta en .gitignore).
#
# Generar un valor aleatorio para las claves:  openssl rand -base64 32

# --- MySQL ---------------------------------------------------------
DB_NAME=bgoat
DB_USER=bgoat
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Seguridad -----------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --- Red -----------------------------------------------------------
# Puerto publico del VPS. El 80 y el 443 son de Bitemo.
PUERTO_PUBLICO=8080
# Lista blanca de origenes en produccion. El panel y la API se sirven desde el
# mismo origen (Nginx enruta /api), asi que el navegador ni siquiera dispara
# CORS; esto es la red de seguridad para clientes externos.
CORS_ORIGINS=http://144.202.34.180:8080
